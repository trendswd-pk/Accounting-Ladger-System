# -----------------------------------------------------------------------------
# Data architecture
#   • Supabase  = normal rows (accounts, settings, journals, file metadata)
#   • Cloudflare R2 = file bytes (uploads via presigned PUT; never stored in DB)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


JWT_SECRET=your-random-secret-at-least-32-chars


CRON_SECRET=your-strong-random-cron-secret


# R2 — https://developers.cloudflare.com/r2/
# Bucket CORS must allow PUT from your app origin (e.g. http://localhost:3000).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_FOLDER_PREFIX=attachments
